PORT=8000
JWT_SECRET=booksaw_super_secure_jwt_secret_key_2026
NODE_ENV=development

# ══════════════════════════════════════════════════════
#  MONGODB ATLAS DATABASE
# ══════════════════════════════════════════════════════
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# ══════════════════════════════════════════════════════
#  RAZORPAY PAYMENT GATEWAY
# ══════════════════════════════════════════════════════
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_MODE=test
CURRENCY=INR
RAZORPAY_STORE_NAME=BookSaw E-Books

# ══════════════════════════════════════════════════════
#  SUPABASE STORAGE & DATABASE (RENDER / PRODUCTION)
# ══════════════════════════════════════════════════════
SUPABASE_URL=https://ppevbwymzlgrutfcojpe.supabase.co
# Server-side Secret Service Role Key (REQUIRED on Backend / Render to upload to private 'ebooks' bucket)
# Obtain from: Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# Optional client/publishable key
SUPABASE_KEY=sb_publishable_-FKEjoWLH5D8W19tK4hmZg_Cd_gb9wj
SUPABASE_BUCKET=ebooks
SUPABASE_COVERS_BUCKET=book-covers
NEXT_PUBLIC_SUPABASE_URL=https://ppevbwymzlgrutfcojpe.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_-FKEjoWLH5D8W19tK4hmZg_Cd_gb9wj
